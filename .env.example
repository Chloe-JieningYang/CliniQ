# Hugging Face Token
# Get your token from: https://huggingface.co/settings/tokens
# Make sure to accept terms at: https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=your_token_here

# Backend: fixed stub replies for UI/API testing without torch/GPU
# CLINIQ_MOCK_GENERATION=true

# Backend: skip loading PEFT (pytest / CI)
# CLINIQ_SKIP_MODEL_LOAD=true

# Backend RAG: FAISS retrieval before /chat generation (requires rag/faiss_index from rag/build_vector.py)
# CLINIQ_RAG_ENABLED=true
# CLINIQ_RAG_TOP_K=3
# CLINIQ_RAG_INDEX_PATH=/abs/path/to/faiss_index
